# BotFather bergan token (hech qachon gitga qo'ymang)
BOT_TOKEN=
# HTTP port (konteyner ichida)
PORT=8080
# Tashqaridan ochiladigan manzil. https bo'lsa admin panel Telegram ichida (Mini App) ochiladi
PUBLIC_URL=http://localhost:8080
# polling — oddiy server; webhook — https PUBLIC_URL bilan
BOT_MODE=polling
# Doimiy adminlar (Telegram user id), vergul bilan. Bo'sh bo'lsa — logdagi /claim kodi bilan
ADMIN_IDS=
# SQLite fayli
DATABASE_PATH=./data/gateway.db
# docker compose: hostdagi port (faqat 127.0.0.1 da ochiladi)
HOST_PORT=8080
